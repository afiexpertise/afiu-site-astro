---
import type { FormationEntry } from '@/lib/content';
import { entryDescription, entryLocale, entrySlug, entryTitle, isPublished } from '@/lib/content';
import { skillDownload } from '@/lib/skills';
import { withBase, type Locale } from '@/i18n';

interface Props { entries: FormationEntry[]; locale: Locale; }
const { entries, locale } = Astro.props;
const fr = locale === 'fr-ca';

function field(body: string, name: string): string | null {
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const bold = body.match(new RegExp(`^\\s*[-*]\\s*\\*\\*${escaped}\\s*:\\*\\*\\s*(.+)$`, 'mi'));
  if (bold) return bold[1].trim();
  const section = body.match(new RegExp(`^# ${escaped}\\s*\\n+([^#\\n]+)`, 'mi'));
  return section?.[1]?.trim() ?? null;
}
function summary(body: string, fallback: string): string {
  const result = body.match(/^# Résumé\s*\n+([^\n#]+)/m)?.[1]?.trim();
  return result || fallback;
}
function category(body: string, title: string): string {
  const product = field(body, 'Produit');
  const path = field(body, 'Parcours');
  if (/^gabarit/i.test(title) || /gabarit commun|gabarit conceptuel/i.test(field(body, 'Ordre') ?? '')) {
    return 'Gabarits pédagogiques';
  }
  if (product && product !== 'Tronc commun') return product;
  if (product === 'Tronc commun') return 'Tronc commun';
  return path || 'Autres formations';
}
const preferred = [
  'Tronc commun', 'Microsoft Copilot', 'Microsoft 365 Copilot', 'OpenAI ChatGPT',
  'Anthropic Claude', 'Mistral Vibe', 'Productivité augmentée',
  'Agentique', 'Transformation du travail', 'Gouvernance', 'Architecture technique',
  'Cursus IA orienté tâches', 'Gabarits pédagogiques',
];
const courses = entries
  .filter((entry) => entryLocale(entry) === locale && isPublished(entry) && entry.data.type === 'Course' && entrySlug(entry).endsWith('/course'))
  .map((entry) => {
    const slug = entrySlug(entry).split('/').at(-2) ?? '';
    const body = entry.body ?? '';
    const title = entryTitle(entry);
    const track = category(body, title);
    const rank = Number.parseInt(field(body, 'Ordre') ?? '', 10);
    const hasSkills = Boolean(skillDownload(slug, 'formateur') && skillDownload(slug, 'apprenant'));
    return {
      slug, title, track, rank: Number.isFinite(rank) ? rank : 999,
      duration: entry.data.duration_minutes, level: String(entry.data.level ?? ''),
      status: entry.data.status ?? '', description: summary(body, entryDescription(entry, locale)),
      url: withBase(`/${locale}/formations/${entrySlug(entry)}/`),
      hasSkills,
    };
  });
const groups = [...new Set(courses.map((course) => course.track))]
  .sort((a, b) => {
    const aa = preferred.indexOf(a), bb = preferred.indexOf(b);
    return (aa < 0 ? 999 : aa) - (bb < 0 ? 999 : bb) || a.localeCompare(b, 'fr');
  })
  .map((name) => ({
    name,
    id: name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-'),
    modules: courses.filter((course) => course.track === name).sort((a, b) => a.rank - b.rank || a.title.localeCompare(b.title, 'fr')),
  }));
const verified = courses.filter((course) => course.hasSkills).length;
---
<div class="learning-explorer mt-10" data-learning-explorer>
  <section class="explorer-toolbar rounded-2xl border border-border bg-card p-5 md:p-6" aria-label={fr ? 'Explorer les formations' : 'Explore training'}>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-brand-600">Courses as Code · OKF</p>
        <h2 class="mt-1 font-display text-2xl font-bold">{fr ? 'Construire son parcours' : 'Build your learning path'}</h2>
        <p class="mt-2 text-sm text-foreground-muted">
          {courses.length} {fr ? 'formations structurées' : 'structured courses'} · {groups.length} {fr ? 'parcours' : 'learning tracks'}
          · {verified} {fr ? 'avec Skills compilés confirmés' : 'with verified compiled Skills'}
        </p>
      </div>
      <span class="rounded-full bg-brand-500/10 px-4 py-2 text-sm font-semibold text-brand-600">
        {fr ? 'Source : référentiel OKF' : 'Source: OKF repository'}
      </span>
    </div>
    <div class="mt-6 grid gap-3 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto]">
      <div>
        <label for="learning-search" class="mb-1 block text-xs font-semibold text-foreground-muted">{fr ? 'Rechercher un cours, une compétence ou un outil' : 'Search courses, skills or tools'}</label>
        <input id="learning-search" data-path-search type="search" autocomplete="off"
          placeholder={fr ? 'Ex. Copilot, agents, conversation…' : 'E.g. Copilot, agents, conversation…'}
          class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground outline-none focus:border-brand-500"/>
      </div>
      <div>
        <label for="learning-track" class="mb-1 block text-xs font-semibold text-foreground-muted">{fr ? 'Parcours' : 'Track'}</label>
        <select id="learning-track" data-path-track class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm text-foreground focus:border-brand-500">
          <option value="">{fr ? 'Tous les parcours' : 'All tracks'}</option>
          {groups.map((group) => <option value={group.id}>{group.name}</option>)}
        </select>
      </div>
      <label class="self-end flex min-h-12 items-center gap-2 rounded-xl border border-border bg-background px-4 text-xs font-semibold">
        <input data-path-ready type="checkbox" class="accent-brand-500"/>
        {fr ? 'Skills disponibles' : 'Published Skills'}
      </label>
    </div>
    <p class="mt-3 text-sm text-foreground-muted" aria-live="polite" data-path-count>
      {courses.length} {fr ? 'formations affichées' : 'courses shown'}
    </p>
  </section>

  <div class="mt-8 space-y-6" data-path-groups>
    {groups.map((group, index) => (
      <section class="track-section rounded-2xl border border-border bg-card p-5 md:p-7" data-path-section={group.id} aria-labelledby={`path-${group.id}`}>
        <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="track-step flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-foreground-muted">{index === 0 ? (fr ? 'Fondations' : 'Foundations') : (fr ? 'Spécialisation' : 'Specialization')}</p>
              <h3 id={`path-${group.id}`} class="font-display text-xl font-bold md:text-2xl">{group.name}</h3>
            </div>
          </div>
          <span class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-foreground-muted">{group.modules.length} modules</span>
        </div>
        <div class="track-grid">
          {group.modules.map((course) => (
            <a href={course.url} class="module-card group relative flex h-full flex-col rounded-xl border border-border bg-background p-5 transition hover:-translate-y-1 hover:border-brand-500 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-brand-500"
              data-path-card data-course-text={`${course.title} ${course.description} ${course.track} ${course.level}`.toLocaleLowerCase('fr-CA')}
              data-ready={course.hasSkills ? 'true' : 'false'}>
              <div class="mb-3 flex items-center justify-between gap-3 text-xs font-semibold text-foreground-muted">
                <span>{course.rank !== 999 ? `M${course.rank}` : (fr ? 'Formation' : 'Course')} · {course.duration ? `${course.duration} min` : 'AFIU'}</span>
                <span aria-hidden="true" class="text-brand-500">↗</span>
              </div>
              <h4 class="font-display text-lg font-bold leading-snug">{course.title}</h4>
              <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-foreground-muted">{course.description}</p>
              <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-border pt-4 text-xs">
                <span class:list={['rounded-full px-2.5 py-1 font-semibold', course.hasSkills ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'bg-secondary text-foreground-muted']}>
                  {course.hasSkills ? (fr ? 'Skills prêts dans OKF' : 'OKF Skills ready') : (fr ? 'Skills non publiés' : 'Skills unpublished')}
                </span>
                {course.level && <span class="text-foreground-muted">{course.level}</span>}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  <div data-path-empty hidden class="mt-8 rounded-2xl border border-dashed border-border bg-card p-10 text-center text-foreground-muted">
    {fr ? 'Aucune formation ne correspond à ces filtres.' : 'No courses match these filters.'}
  </div>
</div>

<style>
  .track-step { color: var(--color-brand-600); background: color-mix(in srgb, var(--color-brand-500) 12%, var(--color-card)); }
  .track-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 245px), 1fr)); gap: 1rem; }
  .track-section { position: relative; }
  .track-section::before { content: ''; position: absolute; top: -1.6rem; left: 2.65rem; height: 1.25rem; width: 2px; background: var(--color-border); }
  .track-section:first-child::before { display: none; }
  .track-section:first-child { border-color: color-mix(in srgb, var(--color-brand-500) 45%, var(--color-border)); }
  .module-card:hover { background: color-mix(in srgb, var(--color-brand-500) 4%, var(--color-background)); }
  [hidden] { display: none !important; }
</style>
<script>
  function initializeExplorer() {
    const root = document.querySelector<HTMLElement>('[data-learning-explorer]');
    if (!root) return;
    const search = root.querySelector<HTMLInputElement>('[data-path-search]');
    const track = root.querySelector<HTMLSelectElement>('[data-path-track]');
    const ready = root.querySelector<HTMLInputElement>('[data-path-ready]');
    const count = root.querySelector<HTMLElement>('[data-path-count]');
    const empty = root.querySelector<HTMLElement>('[data-path-empty]');
    if (!search || !track || !ready || !count || !empty) return;
    const apply = () => {
      const query = search.value.trim().toLocaleLowerCase('fr-CA');
      let visible = 0;
      for (const section of root.querySelectorAll<HTMLElement>('[data-path-section]')) {
        let inGroup = 0;
        for (const card of section.querySelectorAll<HTMLElement>('[data-path-card]')) {
          const matches = (!query || (card.dataset.courseText ?? '').includes(query))
            && (!ready.checked || card.dataset.ready === 'true')
            && (!track.value || section.dataset.pathSection === track.value);
          card.hidden = !matches;
          if (matches) { visible++; inGroup++; }
        }
        section.hidden = inGroup === 0;
      }
      count.textContent = `${visible} ${document.documentElement.lang === 'fr-ca' ? 'formations affichées' : 'courses shown'}`;
      empty.hidden = visible !== 0;
    };
    search.oninput = apply;
    track.onchange = apply;
    ready.onchange = apply;
    apply();
  }
  document.addEventListener('astro:page-load', initializeExplorer);
  initializeExplorer();
</script>
