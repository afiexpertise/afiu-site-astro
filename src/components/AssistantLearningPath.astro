---
import { withBase } from '@/i18n';
import type { AssistantPathModule, AssistantPathTrack } from '@/lib/assistantPath';

interface Props {
  common: AssistantPathModule[];
  tracks: AssistantPathTrack[];
}

const { common, tracks } = Astro.props;
const courseHref = (slug: string) =>
  withBase(`/fr-ca/formations/universities/technique/courses/${slug}/course/`);
---

<div class="assistant-path" aria-label="Parcours de formation des assistants IA">
  <div class="path-scroll">
    <section class="common-lane" aria-label="Tronc commun">
      <div class="lane-heading">
        <span class="lane-kicker">Tronc commun</span>
        <strong>De la compréhension à la conversation de travail</strong>
      </div>
      <div class="module-row common-row">
        {
          common.map((module, index) => (
            <>
              <a class:list={['module-card', module.order === 0 && 'module-card--intro']} href={courseHref(module.slug)}>
                <span class="module-meta">Module {module.order} · {module.duration === 120 ? '120 min' : '3 h 30'}</span>
                <strong>{module.label}</strong>
                <span class="module-focus">{module.focus}</span>
                <span class="module-action">Voir le détail <span aria-hidden="true">→</span></span>
              </a>
              {index < common.length - 1 && <span class="connector" aria-hidden="true">→</span>}
            </>
          ))
        }
      </div>
    </section>

    <div class="branch-label" aria-hidden="true">
      <span>Choisir son environnement</span>
    </div>

    <div class="track-stack">
      {
        tracks.map((track) => (
          <section
            class="track-lane"
            style={`--track-color:${track.color};--track-tint:${track.tint}`}
            aria-labelledby={`track-${track.id}`}
          >
            <div class="track-heading">
              <div>
                <span class="lane-kicker">{track.eyebrow}</span>
                <h2 id={`track-${track.id}`}>{track.name}</h2>
              </div>
              <span class="track-count">{track.modules.length} modules</span>
            </div>
            <div class="module-row">
              {
                track.modules.map((module, index) => (
                  <>
                    <a class="module-card track-card" href={courseHref(module.slug)}>
                      <span class="module-meta">Module {module.order} · 3 h 30</span>
                      <strong>{module.label}</strong>
                      <span class="module-focus">{module.focus}</span>
                      <span class="module-action">Voir le détail <span aria-hidden="true">→</span></span>
                    </a>
                    {index < track.modules.length - 1 && <span class="connector track-connector" aria-hidden="true">→</span>}
                  </>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </div>
</div>

<style>
  .assistant-path {
    position: relative;
    margin-top: 2.5rem;
  }

  .path-scroll {
    display: grid;
    gap: 1.25rem;
  }

  .common-lane,
  .track-lane {
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-card);
    padding: 1.25rem;
    box-shadow: 0 16px 38px rgb(0 0 0 / 5%);
  }

  .common-lane {
    border-color: color-mix(in oklch, var(--color-brand-500) 42%, var(--color-border));
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--color-brand-500) 8%, var(--color-card)), var(--color-card) 55%);
  }

  .lane-heading,
  .track-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .lane-heading strong,
  .track-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-foreground);
  }

  .lane-kicker {
    display: block;
    margin-bottom: .2rem;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .track-lane {
    border-color: color-mix(in srgb, var(--track-color) 55%, var(--color-border));
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--track-tint) 78%, var(--color-card)), var(--color-card) 50%);
  }

  :global(.dark) .track-lane {
    background:
      linear-gradient(115deg, color-mix(in srgb, var(--track-color) 12%, var(--color-card)), var(--color-card) 55%);
  }

  .track-heading h2 {
    font-size: 1.15rem;
  }

  .track-count {
    white-space: nowrap;
    border: 1px solid color-mix(in srgb, var(--track-color) 35%, var(--color-border));
    border-radius: 999px;
    padding: .3rem .65rem;
    font-size: .72rem;
    font-weight: 700;
    color: var(--color-foreground-muted);
  }

  .module-row {
    display: flex;
    align-items: stretch;
    gap: .65rem;
    overflow-x: auto;
    padding: .25rem .15rem .55rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .module-card {
    position: relative;
    display: flex;
    flex: 0 0 13.5rem;
    min-height: 9.5rem;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: color-mix(in oklch, var(--color-background) 78%, var(--color-card));
    padding: 1rem;
    color: var(--color-foreground);
    text-decoration: none;
    scroll-snap-align: start;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .module-card:hover,
  .module-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-brand-500);
    box-shadow: 0 14px 26px rgb(0 0 0 / 10%);
    outline: none;
  }

  .track-card:hover,
  .track-card:focus-visible {
    border-color: var(--track-color);
    background: color-mix(in srgb, var(--track-tint) 52%, var(--color-card));
  }

  :global(.dark) .track-card:hover,
  :global(.dark) .track-card:focus-visible {
    background: color-mix(in srgb, var(--track-color) 14%, var(--color-card));
  }

  .module-card--intro {
    border-color: #d59a00;
    background: color-mix(in srgb, #fef3c7 65%, var(--color-card));
  }

  :global(.dark) .module-card--intro {
    background: color-mix(in srgb, #d59a00 13%, var(--color-card));
  }

  .module-meta {
    margin-bottom: .55rem;
    font-size: .69rem;
    font-weight: 800;
    letter-spacing: .025em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .module-card strong {
    font-family: var(--font-display);
    font-size: .92rem;
    line-height: 1.25;
  }

  .module-focus {
    margin-top: .45rem;
    font-size: .76rem;
    line-height: 1.35;
    color: var(--color-foreground-muted);
  }

  .module-action {
    margin-top: auto;
    padding-top: .8rem;
    font-size: .72rem;
    font-weight: 800;
    color: var(--color-brand-600);
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .track-card .module-action {
    color: var(--track-color);
  }

  .module-card:hover .module-action,
  .module-card:focus-visible .module-action {
    opacity: 1;
    transform: translateY(0);
  }

  .connector {
    display: grid;
    flex: 0 0 1rem;
    place-items: center;
    color: var(--color-foreground-muted);
    font-weight: 800;
  }

  .track-connector {
    color: var(--track-color);
  }

  .branch-label {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-inline: 1rem;
    color: var(--color-foreground-muted);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .branch-label::before,
  .branch-label::after {
    height: 1px;
    flex: 1;
    content: '';
    background: var(--color-border);
  }

  .track-stack {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 720px) {
    .common-lane,
    .track-lane {
      border-radius: 1.1rem;
      padding: 1rem;
    }

    .lane-heading,
    .track-heading {
      align-items: start;
      flex-direction: column;
    }

    .module-card {
      flex-basis: 12.25rem;
    }

    .module-action {
      opacity: 1;
      transform: none;
    }
  }
</style>
