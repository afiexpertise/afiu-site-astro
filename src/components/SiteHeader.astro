---
import BrandMark from './BrandMark.astro';
import { t, withBase, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const alternate = locale === 'fr-ca' ? 'en-ca' : 'fr-ca';
const currentLocalePath = Astro.url.pathname.split(`/${locale}/`)[1] ?? '';
const alternatePath =
  currentLocalePath.startsWith('formations/') && currentLocalePath !== 'formations/'
    ? 'formations/'
    : currentLocalePath.startsWith('parcours-assistants-ia')
      ? 'formations/'
      : currentLocalePath;
const localePath = `/${alternate}/${alternatePath}`;
const alternateHref = withBase(localePath.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), ''));
const homeHref = withBase(`/${locale}/`);
const trainingHref = withBase(`/${locale}/formations/`);
const assistantPathHref = withBase('/fr-ca/parcours-assistants-ia/');
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="site-container glass-header mt-4 flex h-16 items-center justify-between rounded-2xl px-4 md:px-6">
    <a href={homeHref} class="flex items-center gap-2.5" aria-label="AFIU">
      <BrandMark class="h-8 w-8" />
      <span class="font-display text-lg font-bold tracking-tight">AFIU</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={locale === 'fr-ca' ? 'Navigation principale' : 'Main navigation'}>
      <a class="rounded-lg px-3 py-2 text-sm font-medium text-foreground-muted transition hover:bg-secondary hover:text-foreground" href={homeHref}>
        {copy.navHome}
      </a>
      <a class="rounded-lg px-3 py-2 text-sm font-medium text-foreground-muted transition hover:bg-secondary hover:text-foreground" href={trainingHref}>
        {copy.navTraining}
      </a>
      {
        locale === 'fr-ca' && (
          <a
            class="rounded-lg px-3 py-2 text-sm font-medium text-foreground-muted transition hover:bg-secondary hover:text-foreground"
            href={assistantPathHref}
          >
            {copy.navAssistantPath}
          </a>
        )
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={alternateHref}
        hreflang={alternate}
        class="rounded-lg px-3 py-2 text-sm font-semibold text-foreground-muted transition hover:bg-secondary hover:text-foreground"
      >
        {alternate === 'fr-ca' ? 'FR' : 'EN'}
      </a>
      <button id="theme-toggle" type="button" class="rounded-lg p-2 text-foreground-muted transition hover:bg-secondary hover:text-foreground" aria-label="Toggle colour theme">
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const bindThemeToggle = () => {
    document.querySelector('#theme-toggle')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  };
  bindThemeToggle();
  document.addEventListener('astro:after-swap', bindThemeToggle);
</script>
