---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TrainingPathExplorer from '@/components/TrainingPathExplorer.astro';
import { withBase } from '@/i18n';
export function getStaticPaths() {
  return [{ params: { locale: 'fr-ca' } }];
}
const entries = await getCollection('formations');
---
<SiteLayout
  locale="fr-ca"
  title="Parcours interactif — Assistants IA"
  description="Des fondations communes aux spécialisations par outil : explorez les formations AFIU et les Skills publiés dans l'OKF."
>
  <section class="pb-20 pt-36">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-brand-500">AFIU · Parcours IA</p>
        <h1 class="font-display text-4xl font-bold tracking-tight md:text-6xl">Du dialogue à la collaboration avec l’IA</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-foreground-muted">
          Le parcours part du travail à accomplir, développe les compétences communes puis s'ouvre sur les spécialisations
          Microsoft Copilot, Microsoft 365 Copilot, ChatGPT, Claude et Mistral. Les pratiques transversales, la gouvernance
          et l'agentique complètent le cursus. Chaque étape est reliée à sa définition dans l’OKF.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
          <span class="rounded-full border border-border bg-card px-4 py-2">M0 · 120 minutes</span>
          <span class="rounded-full border border-border bg-card px-4 py-2">Autres modules · 3 h 30 selon le cours</span>
          <span class="rounded-full border border-border bg-card px-4 py-2">30 % théorie · 60 % pratique · 10 % collectif</span>
        </div>
      </div>
      <TrainingPathExplorer entries={entries} locale="fr-ca" />
      <div class="mt-8 rounded-2xl border border-border bg-background-secondary p-6">
        <h2 class="font-display text-xl font-bold">Un cours, une seule source de vérité</h2>
        <p class="mt-2 text-sm leading-relaxed text-foreground-muted">
          Les fiches sont publiées depuis le référentiel OKF. Sur chaque cours, les Skills formateur et apprenant
          deviennent téléchargeables uniquement après compilation et publication dans les Releases GitHub de l'OKF.
          L'accès privé à GitHub reste nécessaire.
        </p>
        <a href={withBase('/fr-ca/formations/')} class="mt-4 inline-block text-sm font-bold text-brand-600">Catalogue complet →</a>
      </div>
    </div>
  </section>
</SiteLayout>
