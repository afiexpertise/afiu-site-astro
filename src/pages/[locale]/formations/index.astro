---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import TrainingPathExplorer from '@/components/TrainingPathExplorer.astro';
import { isLocale, locales, t, withBase, type Locale } from '@/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const copy = t(locale);
const entries = await getCollection('formations');
---
<SiteLayout locale={locale} title={copy.trainingTitle} description={copy.trainingDescription}>
  <section class="pb-20 pt-36">
    <div class="site-container">
      <div class="max-w-4xl">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-brand-500">AFIU · Courses as Code · OKF</p>
        <h1 class="font-display text-4xl font-bold tracking-tight md:text-6xl">{copy.trainingTitle}</h1>
        <p class="mt-5 text-lg leading-relaxed text-foreground-muted">
          {locale === 'fr-ca'
            ? 'Parcourez le cursus, choisissez une spécialisation et ouvrez les cours. Les ressources des formateurs proviennent directement du dépôt OKF, sans copie sur ce site.'
            : 'Explore the curriculum, choose a specialization and open a course. Trainer resources link directly to the OKF repository, never copied onto this site.'}
        </p>
      </div>
      <TrainingPathExplorer entries={entries} locale={locale} />
      {locale === 'fr-ca' &&
        <a href={withBase('/fr-ca/parcours-assistants-ia/')} class="mt-8 inline-flex rounded-xl border border-border bg-card px-5 py-3 text-sm font-semibold hover:border-brand-500">
          Comprendre la progression du parcours IA →
        </a>}
    </div>
  </section>
</SiteLayout>
