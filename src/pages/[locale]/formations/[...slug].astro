---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { entryDescription, entryLocale, entrySlug, entryTitle, isPublished } from '@/lib/content';
import { isLocale, t, withBase, type Locale } from '@/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('formations');
  return entries
    .filter(isPublished)
    .flatMap((entry) => {
      const locale = entryLocale(entry);
      const slug = entrySlug(entry);
      return locale && slug ? [{ params: { locale, slug }, props: { entry } }] : [];
    });
}

interface Props {
  entry: CollectionEntry<'formations'>;
}

const { entry } = Astro.props;
const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const copy = t(locale);
const title = entryTitle(entry);
const { Content } = await render(entry);
const crumbs = entrySlug(entry).split('/');
---

<SiteLayout locale={locale} title={title} description={entryDescription(entry, locale)}>
  <article class="pb-20 pt-32">
    <div class="site-container">
      <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-foreground-muted" aria-label="Breadcrumb">
        <a class="hover:text-brand-500" href={withBase(`/${locale}/formations/`)}>{copy.backToTraining}</a>
        {crumbs.slice(0, -1).map((crumb) => <><span>/</span><span class="capitalize">{crumb.replaceAll('-', ' ')}</span></>)}
      </nav>

      <header class="max-w-4xl border-b border-border pb-9">
        <div class="mb-5 flex flex-wrap gap-2">
          {entry.data.type && <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600">{entry.data.type}</span>}
          {entry.data.university && <span class="rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-foreground-muted">{entry.data.university}</span>}
        </div>
        <h1 class="font-display text-4xl font-bold tracking-tight md:text-6xl">{title}</h1>
        <p class="mt-5 max-w-3xl text-lg text-foreground-muted">{entryDescription(entry, locale)}</p>
        <div class="mt-6 flex flex-wrap gap-5 text-sm text-foreground-muted">
          {entry.data.duration_minutes && <span>{copy.duration} · {entry.data.duration_minutes} {copy.minutes}</span>}
          <span>{copy.updatedFrom}</span>
        </div>
      </header>

      <div class="content-prose mt-10 max-w-4xl">
        <Content />
      </div>
    </div>
  </article>
</SiteLayout>
