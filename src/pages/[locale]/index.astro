---
import { getCollection } from 'astro:content';
import FormationCard from '@/components/FormationCard.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { catalogueEntries } from '@/lib/content';
import { isLocale, locales, t, withBase, type Locale } from '@/i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const copy = t(locale);
const formations = catalogueEntries(await getCollection('formations'), locale).slice(0, 3);
---

<SiteLayout locale={locale}>
  <section class="relative overflow-hidden pb-24 pt-40 md:pb-32 md:pt-48">
    <div class="hero-grid pointer-events-none absolute inset-0 -z-10"></div>
    <div class="pointer-events-none absolute left-1/2 top-24 -z-10 h-80 w-80 -translate-x-1/2 rounded-full bg-brand-500/15 blur-3xl"></div>
    <div class="site-container text-center">
      <p class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-xs font-semibold text-brand-600">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span>
        {copy.sourceBadge}
      </p>
      <h1 class="mx-auto max-w-4xl font-display text-5xl font-bold tracking-tight md:text-7xl">
        {copy.heroTitle.split(' ').slice(0, -2).join(' ')}
        <span class="text-brand-500"> {copy.heroTitle.split(' ').slice(-2).join(' ')}</span>
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-foreground-muted md:text-xl">{copy.heroDescription}</p>
      <a href={withBase(`/${locale}/formations/`)} class="mt-9 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-semibold text-primary-foreground shadow-lg transition hover:-translate-y-0.5 hover:bg-primary-hover">
        {copy.browse}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="border-t border-border bg-background-secondary py-20">
    <div class="site-container">
      <div class="mb-10 max-w-2xl">
        <h2 class="font-display text-3xl font-bold md:text-4xl">{copy.featuredTitle}</h2>
        <p class="mt-3 text-foreground-muted">{copy.featuredDescription}</p>
      </div>
      {
        formations.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {formations.map((entry) => <FormationCard entry={entry} locale={locale} />)}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-border p-10 text-center">
            <h3 class="font-display text-xl font-bold">{copy.emptyTitle}</h3>
            <p class="mt-2 text-foreground-muted">{copy.emptyDescription}</p>
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>
